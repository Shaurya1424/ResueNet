global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: rescuenet-backend
    metrics_path: /api/metrics
    static_configs:
      - targets: ['{{ app_server_ip }}:5000']

  - job_name: node-exporter
    static_configs:
      - targets: ['{{ app_server_ip }}:9100']

  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']
